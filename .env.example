# Environment Variable Template for Abhigyan Saikia Portfolio & Chatbot
# Copy to .env.local for local overrides. Do NOT commit production secrets.

# AskiDesk Chatbot API endpoint override (defaults to http://localhost:3000/api/chat)
VITE_CHATBOT_API_URL=http://localhost:3000/api/chat

# AskiDesk Business ID tenant partition
VITE_CHATBOT_BUSINESS_ID=cng_biz_8471

# Server-side provider keys (if deploying API route in production)
# CHATBOT_API_SECRET=your_api_secret_here
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
